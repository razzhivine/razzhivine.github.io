ree":291,"total":283},"43a02e77-c936-11f1-9a15-d707488777c3","17:15","Восстановительный фитнес","ГП №1",45,"Корнева Юлия","08e2a7aa-ba79-11e7-7b86-a4bf013441d1",[287,233],"Здоровая спина",[235,236,237,238,239,240,241,242,243,244],"от 14 лет","Урок Основан на принципах лечебной и адаптивной физической культуры, спортивной медицины, методике пилатес, стретчинга, йоги.",1,{"id":293,"day":224,"time":294,"title":269,"hall":161,"stars":228,"duration":270,"trainer":295,"trainerId":296,"kinds":297,"goals":298,"age":4,"description":4,"paid":196,"price":276,"preBooked":196,"free":299,"total":277},"dc05e66c-c87f-11f1-9a15-d707488777c3","17:30","Колесников Денис","79ac538a-9f96-11e7-2789-a4bf013441d0",[161],[236,237,240,241,242,243,244],11,{"id":301,"day":224,"time":302,"title":303,"hall":257,"stars":228,"duration":283,"trainer":259,"trainerId":260,"kinds":304,"goals":305,"age":264,"description":306,"paid":5,"price":188,"preBooked":196,"free":266,"total":266},"52aeb8eb-d389-11f1-9a18-acbd2055bf7b","18:00","Творческая мастерская",[262],[],"Занятие направлено на активизацию познавательной, художественно-эстетической деятельности, творческого развития. Занятие интересно своей многогранностью. В творческой мастерской ребенок научиться создавать поделки своими руками, лепить, вырезать, клеить. Творческая мастерская развивает интеллектуально-творческий потенциал ребенка.",{"id":308,"day":224,"time":302,"title":309,"hall":310,"stars":228,"duration":270,"trainer":311,"trainerId":312,"kinds":313,"goals":314,"age":4,"description":315,"paid":196,"price":316,"preBooked":196,"free":228,"total":317},"4f97acb3-c936-11f1-9a15-d707488777c3","Малая группа «Reformer»","ГП №4","Закатова Екатерина","c5c41354-9f9e-11e7-2789-a4bf013441d0",[233],[235,236,237,238,239,240,241,242,243,244],"Тренировка на специальном тренажёре - reformer, которая мягко прорабатывает мышцы, улучшает осанку и повышает гибкость.",950,2,{"id":319,"day":224,"time":302,"title":269,"hall":161,"stars":228,"duration":270,"trainer":271,"trainerId":272,"kinds":320,"goals":321,"age":4,"description":4,"paid":196,"price":276,"preBooked":196,"free":277,"total":277},"d00140b3-c87f-11f1-9a15-d707488777c3",[161],[275,236,237,240,241,242,243,244],{"id":323,"day":224,"time":324,"title":325,"hall":282,"stars":228,"duration":270,"trainer":326,"trainerId":327,"kinds":328,"goals":329,"age":289,"description":330,"paid":5,"price":188,"preBooked":196,"free":331,"total":283},"61881ee0-c936-11f1-9a15-d707488777c3","18:05","Комбат","Трудникова Ирина","04662864-43fd-11e9-3081-002590357745",[233],[275,235,236,237,238,239,240,241,242,243,244],"Комбат - это программа высокоинтенсивных тренировок, вдохновленная боевыми искусствами, которая нацелена на проработку всех основных мышечных групп и колоссальное развитие физической подготовки, в особенности силы мышц кора.",26,{"id":333,"day":224,"time":334,"title":335,"hall":227,"stars":228,"duration":270,"trainer":284,"trainerId":285,"kinds":336,"goals":337,"age":289,"description":338,"paid":196,"price":246,"preBooked":196,"free":247,"total":299},"43a040f9-c936-11f1-9a15-d707488777c3","18:10","Малая группа ЙОГА В ГАМАКАХ",[233],[235,236,237,238,239,240,241,242,243,244],"Тренировка с использованием основных Асан йоги и специальных упражнений в воздухе, выполняемых в гамаках. Занятие направлено на вытяжение позвоночника, укрепление глубоких мышц, а так же их мягкое растягивание и расслабление.",{"id":340,"day":224,"time":341,"title":269,"hall":161,"stars":228,"duration":270,"trainer":295,"trainerId":296,"kinds":342,"goals":343,"age":4,"description":4,"paid":196,"price":276,"preBooked":196,"free":277,"total":277},"dc05e73b-c87f-11f1-9a15-d707488777c3","18:45",[161],[236,237,240,241,242,243,244],{"id":345,"day":224,"time":346,"title":347,"hall":161,"stars":228,"duration":348,"trainer":349,"trainerId":350,"kinds":351,"goals":352,"age":353,"description":354,"paid":5,"price":188,"preBooked":196,"free":228,"total":355},"f559398a-cc4f-11f1-9a15-d707488777c3","19:00","Аква база",50,"Трофимова Марина","11ab88fc-ba79-11e7-7b86-a4bf013441d1",[161],[236,237,240,241,242,243,244],"от 18 лет","Аквааэробика для начинающих. Обучение базовым элементам аквааэробики в простых комбинациях. Беременным рекомендуется выполнять упражнения низкой интенсивности. Предупредите тренера о своем  положении. Проконсультируйтесь с врачом перед посещением тренировки.",13,{"id":357,"day":224,"time":358,"title":359,"hall":282,"stars":228,"duration":283,"trainer":311,"trainerId":312,"kinds":360,"goals":361,"age":353,"description":362,"paid":5,"price":188,"preBooked":196,"free":363,"total":283},"4f97aad3-c936-11f1-9a15-d707488777c3","19:05","Тон (Сила + Кардио)",[233],[235,236,237,238,239,240,241,242,243,244],"Сочетает блоки силовой, кардио работы и проработки кора в одной комплексной и удобной тренировке. Тренировка TONE включает в себя микс упражнений для проработки всего тела и повышения пульса. Множество пиков помогает сжигать калории и улучшить физическую форму и выдержку, повышая энергичность, гибкость, баланс, ловкость и силу кора.",24,{"id":365,"day":224,"time":366,"title":367,"hall":227,"stars":228,"duration":283,"trainer":326,"trainerId":327,"kinds":368,"goals":369,"age":289,"description":370,"paid":5,"price":188,"preBooked":196,"free":228,"total":371},"61881f62-c936-11f1-9a15-d707488777c3","19:10","Мышцы кора",[233],[275,235,236,237,238,239,240,241,242,243,244],"Тренировка кора, которая гарантирует быстрый результат независимо от уровня подготовки.",20,{"id":373,"day":224,"time":374,"title":269,"hall":161,"stars":228,"duration":270,"trainer":271,"trainerId":272,"kinds":375,"goals":376,"age":4,"description":4,"paid":196,"price":276,"preBooked":196,"free":277,"total":277},"d001416c-c87f-11f1-9a15-d707488777c3","19:50",[161],[275,236,237,240,241,242,243,244],{"id":378,"day":224,"time":379,"title":380,"hall":282,"stars":228,"duration":283,"trainer":311,"trainerId":312,"kinds":381,"goals":383,"age":289,"description":384,"paid":5,"price":188,"preBooked":196,"free":355,"total":283},"4f97abae-c936-11f1-9a15-d707488777c3","20:00","Баланс 45",[233,382],"Для беременных",[235,236,237,238,239,240,241,242,243,244],"Это современный взгляд на йогу с добавлением элементов из Тай-Чи и Пилатеса.\nПрограмма тренировок, основанная на упражнениях из йоги, которая понравится каждому, кто хочет развить гибкость, силу мышц кора и улучшить свое самочувствие. Тренировка предоставляет отличный шанс познакомиться с йогой тем, кому она в новинку. В тоже время более продвинутые члены смогут разнообразить свой опыт занятий традиционной йогой.",{"id":386,"day":224,"time":387,"title":388,"hall":282,"stars":228,"duration":270,"trainer":271,"trainerId":272,"kinds":389,"goals":390,"age":4,"description":391,"paid":196,"price":392,"preBooked":196,"free":393,"total":393},"b8e7dc9c-d1e8-11f1-9a17-ba8332d45f66","21:00","Малая группа Бадминтон",[233],[275,236,237,240,241,242,243,244],"Групповая программа по бадминтону “Динамика, Скорость и Удовольствие” подходит для всех уровней подготовки. Бадминтон развивает реакцию, координацию и укрепляет мышцы, а также улучшает работу сердечно-сосудистой системы. Вы освоите технику ударов, тактику игры и научитесь эффективно передвигаться по площадке. Занятия включают разминку, тренировку ударов и динамичные матчи, что делает процесс увлекательным и полезным.",750,8,{"kinds":395,"titles":397,"trainers":422,"durations":432,"coaches":434,"total":435,"index":436},[161,233,262,382,396,287,167],"Для женщин",[347,398,399,400,401,402,403,380,404,405,256,281,406,325,407,309,388,335,408,409,226,367,410,411,412,413,414,415,416,269,417,418,303,359,419,420,421],"Аквазарядка","Аквапресс","Аквафитнес","Аквафитнес (сила)","Бадминтон","Баланс","Батуты «Дети»","Бесплатный урок \"Мир Сказок\"","Йога","Малая группа «Батут»","Малая группа, Упругие ягодицы","Малая группа. Swim Lite+.","Памп","ПИЛАТЕС","Подготовка к плаванию на открытой воде","ПРЕСС И СТРЕЙТЧИНГ","Пульсометры. Дети","Рисовайка","Секция Гамаки 5-13 лет","Секция Танцы в гамаках","Стр